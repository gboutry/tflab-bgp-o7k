+def test_preflight_allows_local_provider_bridge(context, tmp_path, monkeypatch):
+    import dataclasses
+
+    node = dataclasses.replace(
+        context.local, provider_interface=None, provider_bridge="br-interconnect"
+    )
+    deployment = dataclasses.replace(
+        context.deployment, controllers=(node, *context.deployment.controllers[1:])
+    )
+    context = dataclasses.replace(context, deployment=deployment)
+    monkeypatch.setattr(setup.os, "geteuid", lambda: 0)
+    monkeypatch.setattr(setup.socket, "gethostname", lambda: node.name)
+    monkeypatch.setattr(setup, "LOCAL_STATE", tmp_path / "context.json")
+    monkeypatch.setattr(setup.utils, "REGRESS_STACK_DIR", tmp_path)
+    monkeypatch.setattr(
+        setup.common,
+        "run",
+        Mock(
+            return_value=json.dumps(
+                [
+                    {
+                        "ifname": node.management_interface,
+                        "addr_info": [{"local": node.address, "scope": "global"}],
+                    }
+                ]
+            )
+        ),
+    )
+    packages = Mock(return_value=[])
+    monkeypatch.setattr(setup.profiles, "execution_order", packages)
+    setup.local_preflight(context)
+    packages.assert_called_once_with(context)
