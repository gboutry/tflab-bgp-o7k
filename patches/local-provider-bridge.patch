+def test_local_provider_bridge_without_uplink(context, monkeypatch):
+    node = dataclasses.replace(
+        context.local, provider_interface=None, provider_bridge="br-interconnect"
+    )
+    deployment = dataclasses.replace(
+        context.deployment, controllers=(node, *context.deployment.controllers[1:])
+    )
+    context = dataclasses.replace(context, deployment=deployment)
+    run = Mock()
+    write = Mock()
+    monkeypatch.setattr(common, "run", run)
+    monkeypatch.setattr(common, "write", write)
+    monkeypatch.setattr(common, "restart", Mock())
+    monkeypatch.setattr(common, "done", lambda _: True)
+    with activate(context):
+        networking.setup()
+    run.assert_any_call("ovs-vsctl", ["--may-exist", "add-br", "br-interconnect"])
+    settings = next(
+        call.args[1]
+        for call in run.call_args_list
+        if call.args[0] == "ovs-vsctl" and call.args[1][0] == "set"
+    )
+    assert "external_ids:ovn-bridge-mappings=physnet1:br-interconnect" in settings
+    assert not any("add-port" in call.args[1] for call in run.call_args_list)
+    unit = write.call_args.args[1]
+    assert "ExecStart=/usr/sbin/ip link set br-interconnect up" in unit
+    assert unit.count("ExecStart=") == 1
+    assert "br-ex" not in unit
+
+
+def test_local_provider_bridge_name_is_validated():
+    from regress_stack.core.deployment import Node
+
+    with pytest.raises(ValueError, match="Invalid interface name"):
+        Node("node1", "192.0.2.1", "ens3", provider_bridge="invalid;bridge")
+    with pytest.raises(ValueError, match="must be distinct"):
+        Node("node1", "192.0.2.1", "ens3", provider_bridge="ens3")
