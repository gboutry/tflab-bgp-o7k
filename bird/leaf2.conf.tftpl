router id 192.0.2.12;
protocol device {}
protocol direct { ipv4; }
protocol kernel { ipv4 { import all; export all; }; }

filter host_routes {
    if net = 0.0.0.0/0 || net.len = 32 || net = 172.20.10.0/24 then accept;
    reject;
}

protocol static default_to_hosts {
    ipv4;
    route 0.0.0.0/0 blackhole;
}

protocol bgp spine {
    local 172.20.0.5 as 65002;
    neighbor 172.20.0.6 as 65000;
    ipv4 {
        import filter host_routes;
        export filter { if net.len = 32 then accept; reject; };
        next hop self;
    };
}

protocol bgp hc3 {
    local fe80::1 as 65002;
    interface "eth1";
    neighbor fe80::103%eth1 as 65103;
    ipv4 {
        extended next hop on;
        import filter { if net.len = 32 then accept; reject; };
        export filter host_routes;
        next hop self;
    };
}
